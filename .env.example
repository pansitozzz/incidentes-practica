# Copia este archivo a ".env" y ajusta los valores para tu entorno local.
# NUNCA subas el archivo ".env" real al repositorio.

# Clave secreta de Django. Genera una nueva con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esta-clave-por-una-generada-localmente

# Modo debug (True solo en desarrollo local)
DEBUG=True

# Hosts permitidos, separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos
# Si USE_SQLITE=True se usa SQLite (db.sqlite3) sin necesidad de Docker/Postgres.
USE_SQLITE=True

# Datos de PostgreSQL (solo se usan si USE_SQLITE=False, por ejemplo con docker-compose)
POSTGRES_DB=incidentes_db
POSTGRES_USER=incidentes_user
POSTGRES_PASSWORD=cambia-esta-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Superusuario de ejemplo (opcional, usado solo por el comando crear_admin/createsuperuser)
# Si no se definen, se debe crear el superusuario de forma interactiva con:
# python manage.py createsuperuser
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=
